# HydraControl Frontend Environment Configuration Template
# Copy this file to .env or .env.production and configure for your deployment

# Backend HTTP API URL (e.g. http://localhost:8000 or your domain)
VITE_API_BASE_URL=http://localhost:8000

# Backend WebSocket Stream URL (e.g. ws://localhost:8000 or your domain)
VITE_WS_BASE_URL=ws://localhost:8000
