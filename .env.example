# HydraControl Environment Configuration

# General
ENVIRONMENT=development
DEBUG=True
PROJECT_NAME="HydraControl Commercial IoT Platform"
API_V1_STR="/api/v1"
SECRET_KEY="hydracontrol_super_secret_development_jwt_key_change_in_prod"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (PostgreSQL / SQLite for local tests)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/hydracontrol
SYNC_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hydracontrol

# MQTT Broker
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_KEEPALIVE=60
MQTT_CLIENT_ID=hydracontrol_backend_gateway

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# WebSocket
WS_HEARTBEAT_INTERVAL_SECONDS=15

# Safety & Command Defaults
DEFAULT_COMMAND_TIMEOUT_SECONDS=10
HEARTBEAT_STALE_THRESHOLD_SECONDS=30
HEARTBEAT_OFFLINE_THRESHOLD_SECONDS=60
